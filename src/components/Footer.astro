---
import Logo from './Logo.astro';
import { site } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <a href="/" class="home" aria-label="Huzur & Co – Startseite"><Logo size="lg" tone="light" /></a>
      <p class="claim">Finde dein Huzur.</p>
    </div>

    <div class="cols">
      <div>
        <p class="label">Folge uns</p>
        <ul class="social">
          <li>
            <a href={site.instagram} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" /></svg>
              <span>Instagram <span class="handle">{site.handle}</span></span>
            </a>
          </li>
          <li>
            <a href={site.tiktok} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" /><path d="M14 3c.4 2.8 2.2 4.6 5 5" /></svg>
              <span>TikTok <span class="handle">{site.handle}</span></span>
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="label">Kontakt</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="origin">Mit Liebe gemacht in Ostwestfalen</p>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} Huzur &amp; Co</span>
      <nav aria-label="Rechtliches">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--night);
    color: #cdbba6;
    padding: clamp(80px, 12vw, 128px) 0 40px;
    font-size: 0.95rem;
  }
  .top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(239, 231, 218, 0.12);
  }
  .home { text-decoration: none; }
  .claim {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--amber-light);
    margin: 0;
  }
  .cols {
    display: grid;
    gap: 40px;
    padding: 48px 0;
    text-align: center;
  }
  .label {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(205, 187, 166, 0.65);
    margin-bottom: 16px;
  }
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    justify-items: center;
  }
  .social a, .mail {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--cream);
    text-decoration: none;
    transition: color 0.3s;
  }
  .social a:hover, .mail:hover { color: var(--amber-light); }
  .social svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .handle { color: #cdbba6; margin-left: 4px; }
  .mail { font-family: var(--serif); font-size: 1.35rem; }
  .origin { margin: 6px 0 0; font-size: 0.9rem; }
  .bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-top: 28px;
    border-top: 1px solid rgba(239, 231, 218, 0.12);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }
  .bottom nav { display: flex; gap: 24px; }
  .bottom a {
    color: #cdbba6;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .bottom a:hover { color: var(--cream); }

  @media (min-width: 760px) {
    .cols { grid-template-columns: 1fr 1fr; text-align: left; }
    .social { justify-items: start; }
    .bottom { flex-direction: row; justify-content: space-between; }
  }
</style>
