---
import Layout from '../layouts/Layout.astro';
import SubHeader from '../components/SubHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
---
<Layout title="Datenschutz – Huzur & Co" description="Datenschutzerklärung von Huzur & Co." noindex>
  <SubHeader />
  <main id="inhalt" class="legal">
    <div class="wrap">
      <p class="kicker">Rechtliches</p>
      <h1>Datenschutz&shy;erklärung</h1>

      <p class="note">
        Platzhalter: Bitte vor dem Livegang eine vollständige Datenschutzerklärung einsetzen und
        prüfen lassen – insbesondere, sobald ein Newsletter-Dienst oder Shop angebunden ist.
      </p>

      <h2>Verantwortliche Stelle</h2>
      <p>[Name, Anschrift]<br />E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>

      <h2>Keine Cookies, kein Tracking</h2>
      <p>
        Diese Website setzt keine Cookies und verwendet keine Analyse- oder Tracking-Dienste.
        Alle Schriftarten werden direkt von unserem Server geladen, es werden keine Daten an
        Google Fonts oder andere Drittanbieter übertragen.
      </p>

      <h2>Hosting</h2>
      <p>[Hosting-Anbieter, z. B. Netlify oder Vercel, mit Hinweis auf Server-Logfiles und Auftragsverarbeitung]</p>

      <h2>Launch-Liste / Newsletter</h2>
      <p>
        [Welcher Dienst verarbeitet die E-Mail-Adresse, Zweck, Rechtsgrundlage (Einwilligung, Art. 6 Abs. 1 lit. a DSGVO),
        Double-Opt-in, Abmeldung jederzeit möglich]
      </p>

      <h2>Deine Rechte</h2>
      <p>[Auskunft, Berichtigung, Löschung, Einschränkung, Widerspruch, Datenübertragbarkeit, Beschwerderecht bei einer Aufsichtsbehörde]</p>
    </div>
  </main>
  <Footer />
</Layout>
