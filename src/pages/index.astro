    color: #cdbba6;
    overflow: hidden;
  }
  .ritual-glow {
    position: absolute;
    left: 50%;
    top: 0;
    width: 900px;
    height: 900px;
    translate: -50% -45%;
    background: radial-gradient(circle, rgba(227, 167, 92, 0.28), transparent 60%);
    animation: breathe 8s ease-in-out infinite;
    pointer-events: none;
