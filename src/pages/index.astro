---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import { kollektion } from '../data/kollektion';
import { launchForm } from '../config';

// Hero-Bild: Sobald du ein eigenes Stimmungsfoto hast, hier den Import austauschen
// (z. B. '../assets/images/hero.jpg'). Hochformat wirkt im Bogen am schönsten.
import heroBild from '../assets/images/kerze-n1-keyif.jpg';
// Bild für „Unsere Geschichte“
import geschichteBild from '../assets/images/kerze-n3-goenuel.jpg';
---

<Layout>
  <header class="header" data-header>
    <div class="wrap header-inner">
      <a href="#top" class="header-logo" aria-label="Huzur & Co – nach oben"><Logo /></a>
      <nav class="header-nav" aria-label="Hauptnavigation">
        <a href="#bedeutung" class="nav-link">Huzur</a>
        <a href="#kollektion" class="nav-link">Kollektion</a>
        <a href="#ritual" class="nav-link">Ritual</a>
        <a href="#launch" class="nav-cta">Eintragen</a>
      </nav>
    </div>
  </header>

  <main id="inhalt">
    <!-- 1 · HERO -->
    <section class="hero" id="top">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-media" data-reveal>
          <div class="hero-frame arch-outline" data-parallax="0.08">
            <div class="arch hero-arch">
              <Picture
                src={heroBild}
                formats={['avif', 'webp']}
                widths={[360, 540, 720, 960]}
                sizes="(min-width: 960px) 420px, 62vw"
                alt="Brennende Duftkerze N°1 Keyif von Huzur & Co im Bernsteinglas mit Bogen-Etikett"
                loading="eager"
                fetchpriority="high"
              />
              <span class="flicker" aria-hidden="true"></span>
            </div>
          </div>
        </div>

        <div class="hero-text">
          <p class="kicker" data-reveal>Handveredelte Duftkerzen</p>
          <h1 class="hero-title" data-reveal style="--delay:.1s">
            Finde dein <em>Huzur</em>
          </h1>
          <p class="hero-lead" data-reveal style="--delay:.2s">
            Kerzen, die nach Ankommen duften. Unsere erste Kollektion erscheint bald<span class="lead-more"> – sei dabei, wenn das Licht angeht.</span></p>
          <div data-reveal style="--delay:.3s">
            <a href="#launch" class="btn">Zum Launch eintragen <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <a href="#bedeutung" class="scroll-hint" aria-label="Weiter nach unten">
        <span></span>
      </a>
    </section>

    <!-- 2 · WAS BEDEUTET HUZUR -->
    <section class="meaning" id="bedeutung">
      <div class="wrap">
        <div class="entry">
          <p class="kicker" data-reveal>Aus dem Wörterbuch</p>
          <h2 class="entry-word" data-reveal lang="tr">Huzur</h2>
          <p class="entry-meta" data-reveal style="--delay:.1s">
            <span class="ipa" lang="tr-fonipa">[hu-ˈzur]</span>
            <span class="meta-sep" aria-hidden="true"></span>
            <span>Substantiv</span>
            <span class="dot" aria-hidden="true">·</span>
            <span>türkisch, mit arabischen Wurzeln</span>
          </p>
          <hr class="entry-rule" data-reveal />
          <ol class="entry-defs">
            <li data-reveal>innere Ruhe, Frieden, Gelassenheit.</li>
            <li data-reveal style="--delay:.1s">
              das Gefühl, wenn man nach einem langen Tag nach Hause kommt, durchatmet und
              einfach ankommt.
            </li>
          </ol>
          <p class="entry-example" data-reveal>„Zuhause finde ich mein Huzur.“</p>
        </div>
        <p class="meaning-close" data-reveal>
          Genau dieses Gefühl wollen wir <em>in jedes Zuhause</em> bringen.
        </p>
      </div>
    </section>

    <!-- 3 · UNSERE GESCHICHTE  (Platzhaltertext – gern anpassen) -->
    <section class="story" id="geschichte">
      <div class="wrap story-inner">
        <div class="story-media" data-reveal>
          <div class="arch-outline" data-parallax="-0.06">
            <div class="arch story-arch">
              <Picture
                src={geschichteBild}
                formats={['avif', 'webp']}
                widths={[360, 540, 720, 900]}
                sizes="(min-width: 960px) 440px, 78vw"
                alt="Duftkerze N°3 Gönül im mattschwarzen Glas mit nachtblauem Etikett und goldener Schrift"
                loading="lazy"
              />
              <span class="flicker" aria-hidden="true"></span>
            </div>
          </div>
          <div class="note-card" aria-hidden="true">
            <span class="note-brand">Huzur <i>&amp; Co.</i></span>
            <span class="note-text">Schön, dass du dein Huzur gefunden hast.</span>
          </div>
        </div>

        <div class="story-text">
          <p class="kicker" data-reveal>Unsere Geschichte</p>
          <h2 class="section-title" data-reveal>Aus Ostwestfalen, <em>für dein Zuhause</em></h2>
          <div class="story-copy">
            <p data-reveal>
              Huzur &amp; Co ist eine junge Marke aus Ostwestfalen. Am Anfang stand eine Erinnerung:
              an Abende bei der Familie, an Tee im Glas, an warmes Licht und Stimmen, die langsam
              leiser werden. Für dieses Gefühl gibt es im Türkischen ein eigenes Wort.
            </p>
            <p data-reveal>
              Wir veredeln jede Kerze von Hand, in kleinen Mengen und ohne Eile. Jede trägt einen
              Namen, der uns etwas bedeutet – und im Karton liegt eine kleine Karte, die dich
              willkommen heißt.
            </p>
            <p data-reveal>
              Für uns ist Luxus leise. Er liegt in dem Moment, den du dir nimmst, und in dem Licht,
              das ihn begleitet.
            </p>
          </div>
          <p class="signature" data-reveal>Von Herzen, Huzur &amp; Co</p>
        </div>
      </div>
    </section>

    <!-- 4 · KOLLEKTION -->
    <section class="collection" id="kollektion">
      <div class="wrap">
        <header class="collection-head">
          <p class="kicker" data-reveal>Die erste Kollektion</p>
          <h2 class="section-title" data-reveal>N°1 <span class="dash">—</span> N°3</h2>
          <p class="collection-intro" data-reveal>
            Drei Kerzen, drei türkische Worte, drei Arten anzukommen. Jede mit 200&nbsp;g Sojawachs,
            eigenem Glas, eigener Etikettenfarbe und einem Topping, das man sieht.
          </p>
        </header>
      </div>

      <div class="cards" data-carousel data-reveal>
        {kollektion.map((k, i) => (
          <article class="card" style={`--c:${k.farbe}; --t:${k.ton}`}>
            <div class="card-media arch">
              <Picture
                src={k.bild}
                formats={['avif', 'webp']}
                widths={[320, 480, 640, 800]}
                sizes="(min-width: 960px) 340px, 78vw"
                alt={k.alt}
                loading="lazy"
              />
              <span class="flicker" aria-hidden="true"></span>
            </div>
            <div class="card-body">
              <p class="card-no">{k.nummer}</p>
              <h3 class="card-name" lang="tr">{k.name}</h3>
              <p class="card-meaning"><span>türk.</span> {k.bedeutung}</p>
              <p class="card-line">{k.stimmung}</p>
              <dl class="card-facts">
                <div>
                  <dt>Duft</dt>
                  <dd class:list={[{ pending: !k.duftnoten }]}>{k.duftnoten || 'Duftnoten folgen'}</dd>
                </div>
                <div>
                  <dt>Glas</dt>
                  <dd>{k.glas}</dd>
                </div>
                <div>
                  <dt>Topping</dt>
                  <dd>{k.topping}</dd>
                </div>
              </dl>
            </div>
          </article>
        ))}
      </div>
      <div class="dots" aria-hidden="true">
        {kollektion.map((_, i) => <span class:list={['dot', { active: i === 0 }]}></span>)}
      </div>
    </section>

    <!-- 5 · DAS RITUAL -->
    <section class="ritual" id="ritual">
      <div class="ritual-glow" aria-hidden="true"></div>
      <div class="wrap">
        <header class="ritual-head">
          <p class="kicker" data-reveal>Das Ritual</p>
          <h2 class="section-title" data-reveal>Drei Schritte <em>bis zur Ruhe</em></h2>
        </header>

        <ol class="steps">
          <li class="step" data-reveal>
            <svg class="step-icon" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M24 6c6 8 9 13 9 18a9 9 0 0 1-18 0c0-5 3-10 9-18z" />
              <path d="M24 18c2.6 3.4 3.8 5.6 3.8 7.4a3.8 3.8 0 0 1-7.6 0c0-1.8 1.2-4 3.8-7.4z" />
              <path d="M24 33v9M18 42h12" />
            </svg>
            <span class="step-no">I</span>
            <h3>Anzünden</h3>
            <p>Lass den Tag hinter dir. Ein Streichholz, eine kleine Flamme – und der Raum wird wärmer.</p>
          </li>
          <li class="step" data-reveal style="--delay:.15s">
            <svg class="step-icon" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M6 18c6-5 12-5 18 0s12 5 18 0" />
              <path d="M6 26c6-5 12-5 18 0s12 5 18 0" />
              <path d="M10 34c5-4 9.5-4 14 0s9 4 14 0" />
            </svg>
            <span class="step-no">II</span>
            <h3>Durchatmen</h3>
            <p>Schließ für einen Moment die Augen. Lass den Duft den Raum füllen, ganz ohne Eile.</p>
          </li>
          <li class="step" data-reveal style="--delay:.3s">
            <svg class="step-icon" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M9 43V21a15 15 0 0 1 30 0v22" />
              <path d="M16 43V23a8 8 0 0 1 16 0v20" />
              <path d="M5 43h38" />
            </svg>
            <span class="step-no">III</span>
            <h3>Ankommen</h3>
            <p>Nichts müssen. Einfach da sein. Das ist dein Huzur.</p>
          </li>
        </ol>

        <p class="ritual-tip" data-reveal>
          <strong>Tipp für den ersten Abend:</strong> Lass die Kerze beim ersten Mal zwei bis drei Stunden brennen,
          bis die Oberfläche ganz geschmolzen ist. So brennt sie später gleichmäßig.
        </p>
      </div>
    </section>

    <!-- 6 · LAUNCH-LISTE -->
    <section class="launch" id="launch">
      <div class="wrap">
        <div class="launch-panel" data-reveal>
          <div class="launch-glow" aria-hidden="true"></div>
          <Logo wordmark={false} />
          <p class="kicker">Launch-Liste</p>
          <h2 class="section-title">Sei unter <em>den Ersten</em></h2>
          <p class="launch-text">
            Trag dich ein und erfahre vor allen anderen, wann N°1 Keyif, N°2 Sefa und N°3 Gönül
            erhältlich sind. Wir schreiben nur, wenn es wirklich etwas zu erzählen gibt.
          </p>

          <form
            class="launch-form"
            data-launch-form
            data-mode={launchForm.mode}
            action={launchForm.action || undefined}
            method="post"
            novalidate
          >
            {Object.entries(launchForm.hiddenFields).map(([name, value]) => (
              <input type="hidden" name={name} value={value} />
            ))}
            <div class="field">
              <label for="launch-email" class="visually-hidden">Deine E-Mail-Adresse</label>
              <input
                id="launch-email"
                name={launchForm.emailField}
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder="Deine E-Mail-Adresse"
                required
              />
              <button type="submit" class="btn">Eintragen</button>
            </div>
            <!-- Honeypot gegen Spam-Bots: bleibt für Menschen unsichtbar -->
            <div class="hp" aria-hidden="true">
              <label>Bitte leer lassen <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <p class="form-msg" role="status" aria-live="polite"></p>
            <p class="consent">
              Mit dem Eintragen erhältst du Neuigkeiten zum Launch per E-Mail. Abmelden kannst du dich
              jederzeit. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.
            </p>
          </form>

          <div class="launch-success" hidden>
            <p class="success-title">Schön, dass du dein Huzur gefunden hast.</p>
            <p>Du stehst auf der Liste. Wir melden uns, sobald das Licht angeht.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ---------- Header ---------- */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    transition: background 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .header.is-scrolled {
    background: rgba(239, 231, 218, 0.86);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .header-logo { text-decoration: none; display: inline-flex; }
  .header-nav { display: flex; align-items: center; gap: 32px; }
  .nav-link {
    display: none;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--amber);
    transform: scaleX(0);
    transition: transform 0.5s var(--ease);
  }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid rgba(143, 84, 25, 0.45);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--amber-text);
    transition: background 0.4s, color 0.4s, border-color 0.4s;
  }
  .nav-cta:hover { background: var(--ink); border-color: var(--ink); color: var(--cream); }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(80px + env(safe-area-inset-top)) 0 40px;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    left: 50%;
    top: 30%;
    width: 150vmax;
    height: 150vmax;
    max-width: 1400px;
    max-height: 1400px;
    translate: -50% -50%;
    background: radial-gradient(circle, rgba(242, 184, 102, 0.34), rgba(239, 231, 218, 0) 55%);
    animation: breathe 9s ease-in-out infinite;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: 26px;
    justify-items: center;
    text-align: center;
  }
  .hero-media { width: clamp(120px, calc((100svh - 400px) * 0.668), min(54vw, 300px)); }
  @media (max-width: 959px) and (max-height: 760px) {
    .hero-text .kicker { display: none; }
  }
  @media (max-width: 959px) {
    .lead-more { display: none; }
    .hero-lead::after { content: '.'; }
  }
  .hero-frame { width: 100%; }
  .hero-arch,
  .story-arch {
    aspect-ratio: 890 / 1333;
    background: #ead9c2;
    filter: drop-shadow(0 30px 40px rgba(91, 57, 25, 0.22));
  }
  .hero-arch :global(img),
  .story-arch :global(img) { mix-blend-mode: multiply; }
  .hero-arch :global(img),
  .story-arch :global(img),
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-title {
    font-size: clamp(3.2rem, 14vw, 7.5rem);
    font-weight: 400;
    line-height: 0.95;
    margin-bottom: 20px;
  }
  .hero-title em {
    display: block;
    font-style: italic;
    color: var(--amber);
    font-weight: 400;
  }
  .hero-text .kicker { margin-bottom: 16px; }
  .hero-lead {
    max-width: 30ch;
    margin: 0 auto 28px;
    font-size: 1.08rem;
    color: var(--text);
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 24px;
    translate: -50% 0;
    width: 44px;
    height: 44px;
    display: none;
    justify-content: center;
  }
  .scroll-hint span {
    width: 1px;
    height: 40px;
    background: linear-gradient(var(--amber), transparent);
    animation: drip 2.8s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ---------- Wörterbuch ---------- */
  .meaning {
    padding: var(--section) 0;
    background: var(--paper);
    text-align: center;
  }
  .entry {
    max-width: 680px;
    margin-inline: auto;
  }
  .entry-word {
    font-size: clamp(5.5rem, 26vw, 12rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 12px;
    margin: 22px 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--muted);
  }
  .ipa { font-style: normal; font-family: var(--sans); font-size: 0.95rem; letter-spacing: 0.06em; color: var(--amber-text); }
  .meta-sep { flex-basis: 100%; height: 0; }
  .entry-rule {
    width: 64px;
    margin: 48px auto;
    border: 0;
    border-top: 1px solid var(--amber);
  }
  .entry-defs {
    list-style: none;
    counter-reset: def;
    margin: 0 auto;
    padding: 0;
    display: grid;
    gap: 22px;
    max-width: 34ch;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 5vw, 1.9rem);
    line-height: 1.35;
    color: var(--ink);
  }
  .entry-defs li { counter-increment: def; }
  .entry-defs li::before {
    content: counter(def);
    display: block;
    margin-bottom: 6px;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--amber-text);
  }
  .entry-example {
    margin: 40px 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--muted);
  }
  .meaning-close {
    max-width: 22ch;
    margin: clamp(80px, 12vw, 140px) auto 0;
    font-family: var(--serif);
    font-size: clamp(1.9rem, 6vw, 3rem);
    line-height: 1.2;
    color: var(--ink);
  }
  .meaning-close em { color: var(--amber-text); }

  /* ---------- Geschichte ---------- */
  .story { padding: var(--section) 0; }
  .story-inner {
    display: grid;
    gap: 72px;
  }
  .story-media {
    position: relative;
    width: min(78vw, 440px);
    margin-inline: auto;
  }
  .note-card {
    position: absolute;
    right: -14px;
    bottom: -36px;
    width: 46%;
    max-width: 180px;
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 22px 14px 14px;
    background: #1f2a3c;
    border-radius: 999px 999px 4px 4px;
    box-shadow: 0 24px 40px -18px rgba(31, 42, 60, 0.7);
    text-align: center;
    rotate: 4deg;
  }
  .note-card::before {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(201, 164, 92, 0.7);
    border-radius: 999px 999px 2px 2px;
  }
  .note-brand {
    font-family: var(--serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c9a45c;
  }
  .note-brand i { display: block; text-transform: none; letter-spacing: 0; font-weight: 400; }
  .note-text {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.25;
    color: #efe7da;
  }
  .story-text { max-width: 560px; margin-inline: auto; }
  .story-text .section-title { margin-bottom: 36px; }
  .story-copy p { font-size: 1.06rem; }
  .signature {
    margin-top: 32px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--amber-text);
  }

  /* ---------- Kollektion ---------- */
  .collection {
    padding: var(--section) 0;
    background: linear-gradient(180deg, var(--sand) 0%, #e9dccb 100%);
  }
  .collection-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 64px;
  }
  .collection-head .section-title { font-weight: 400; }
  .dash { color: var(--amber); }
  .collection-intro { margin-top: 24px; }

  .cards {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 8px var(--gutter) 24px;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .cards::-webkit-scrollbar { display: none; }
  .card {
    flex: 0 0 min(80vw, 360px);
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border-radius: 999px 999px 6px 6px;
    padding: 12px 12px 0;
    box-shadow: 0 30px 60px -40px rgba(74, 48, 24, 0.55);
  }
  .card-media {
    aspect-ratio: 890 / 1180;
    background: var(--t);
  }
  .card-media :global(img) {
    mix-blend-mode: multiply;
    object-position: 50% 90%;
  }
  .card-media .flicker { top: 13%; }
  .card-body {
    padding: 32px 18px 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-no {
