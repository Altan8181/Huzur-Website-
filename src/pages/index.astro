  .ritual-tip strong { color: var(--cream); font-weight: 500; }

  /* ---------- Launch ---------- */
  .launch { padding: var(--section) 0; }
  .launch-panel {
    position: relative;
    max-width: 680px;
    margin-inline: auto;
    padding: clamp(80px, 16vw, 120px) clamp(22px, 7vw, 72px) clamp(48px, 9vw, 72px);
    background: var(--paper);
    border-radius: 999px 999px 8px 8px;
    text-align: center;
    overflow: hidden;
    box-shadow: 0 40px 90px -50px rgba(91, 57, 25, 0.5);
  }
  .launch-panel::before {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(184, 117, 47, 0.35);
    border-radius: 999px 999px 4px 4px;
    pointer-events: none;
  }
  .launch-glow {
    position: absolute;
    left: 50%;
    top: 10%;
    width: 480px;
    height: 480px;
    translate: -50% -50%;
    background: radial-gradient(circle, rgba(242, 184, 102, 0.35), transparent 62%);
    animation: breathe 7s ease-in-out infinite;
    pointer-events: none;
  }
  .launch-panel > :not(.launch-glow) { position: relative; }
  .launch-panel > :global(.logo) { display: flex; justify-content: center; margin-bottom: 28px; }
  .launch-panel :global(.logo-mark) { width: 40px; }
  .launch-panel .kicker { justify-content: center; }
  .launch-panel .kicker::before { display: none; }
  .launch-text { max-width: 40ch; margin: 24px auto 36px; }

  .launch-form .field {
    display: grid;
    gap: 12px;
  }
  .launch-form input[type='email'] {
    width: 100%;
    min-height: 56px;
    padding: 0 24px;
    border: 1px solid rgba(43, 33, 27, 0.22);
    border-radius: 999px;
    background: var(--cream);
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    text-align: center;
    transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
  }
  .launch-form input[type='email']::placeholder { color: #8a7766; }
  .launch-form input[type='email']:focus {
    outline: none;
    border-color: var(--amber);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(184, 117, 47, 0.14);
  }
  .launch-form input[aria-invalid='true'] { border-color: #a4452a; }
  .launch-form .btn { width: 100%; }
  .form-msg { min-height: 1.5em; margin: 12px 0 0; font-size: 0.9rem; color: #a4452a; }
  .consent { margin: 8px auto 0; max-width: 46ch; font-size: 0.8rem; line-height: 1.6; color: var(--muted); }
  .consent a { color: var(--amber-text); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .launch-success { animation: fadeUp 1s var(--ease) both; }
  .success-title {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.8rem, 6vw, 2.4rem);
    line-height: 1.2;
    color: var(--amber-text);
    margin-bottom: 12px;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  /* ---------- ab Tablet ---------- */
  @media (min-width: 640px) {
    .launch-form .field {
      grid-template-columns: 1fr auto;
      gap: 0;
      padding: 6px;
      border: 1px solid rgba(43, 33, 27, 0.18);
      border-radius: 999px;
      background: var(--cream);
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .launch-form .field:focus-within { border-color: var(--amber); box-shadow: 0 0 0 4px rgba(184, 117, 47, 0.14); }
    .launch-form input[type='email'],
    .launch-form input[type='email']:focus {
      border: 0;
      background: transparent;
      box-shadow: none;
      text-align: left;
      min-height: 52px;
    }
    .launch-form .btn { width: auto; min-height: 52px; }
  }

  /* ---------- ab Desktop ---------- */
  @media (min-width: 960px) {
    .nav-link { display: inline-block; }
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 80px;
      align-items: center;
      text-align: left;
      justify-items: start;
    }
    .hero-media { order: 2; width: min(100%, 420px, calc((100svh - 220px) * 0.668)); justify-self: center; }
    .meta-sep { flex-basis: auto; width: 1px; height: 1em; align-self: center; background: var(--amber); opacity: 0.5; }
    .hero-lead { margin-left: 0; }
    .hero-text .kicker { margin-bottom: 30px; }
    .scroll-hint { display: flex; }

    .story-inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 120px;
      align-items: center;
    }
    .story-media { width: 100%; max-width: 440px; }
    .note-card { right: -48px; bottom: -40px; }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      max-width: calc(var(--max) + 2 * var(--gutter));
      margin-inline: auto;
      overflow: visible;
    }
    .card { transition: transform 0.8s var(--ease), box-shadow 0.8s var(--ease); }
    .card:hover { transform: translateY(-8px); box-shadow: 0 40px 70px -40px rgba(74, 48, 24, 0.7); }
    .dots { display: none; }

    .steps { grid-template-columns: repeat(3, 1fr); gap: 48px; }
    .step { position: relative; }
    .step + .step::before {
      content: '';
      position: absolute;
      left: -24px;
      top: 24px;
      bottom: 24px;
      width: 1px;
      background: linear-gradient(transparent, rgba(227, 167, 92, 0.3), transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cards { scroll-behavior: auto; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Header bekommt beim Scrollen einen Hintergrund
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScrollHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScrollHeader();
  window.addEventListener('scroll', onScrollHeader, { passive: true });

  // Sanftes Einblenden beim Scrollen
  const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
  // Hero sofort einblenden – nicht auf das Scrollen warten
  requestAnimationFrame(() =>
    document.querySelectorAll<HTMLElement>('.hero [data-reveal]').forEach((el) => el.classList.add('is-visible'))
  );
  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
    );
    revealEls.forEach((el) => io.observe(el));
  }

  // Leichtes Parallax für Bilder
  const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
  if (!reduceMotion && parallaxEls.length) {
    let ticking = false;
    const update = () => {
      const vh = window.innerHeight;
      parallaxEls.forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.bottom < -100 || rect.top > vh + 100) return;
        const speed = parseFloat(el.dataset.parallax || '0');
        const offset = (rect.top + rect.height / 2 - vh / 2) * speed;
        el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
      });
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  }

  // Punkte unter dem Kollektions-Karussell (mobil)
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const dots = document.querySelectorAll('.dots .dot');
  if (carousel && dots.length) {
    const cards = Array.from(carousel.children) as HTMLElement[];
    carousel.addEventListener(
      'scroll',
      () => {
        const center = carousel.scrollLeft + carousel.clientWidth / 2;
        let active = 0;
        let best = Infinity;
        cards.forEach((card, i) => {
          const d = Math.abs(card.offsetLeft + card.offsetWidth / 2 - center);
          if (d < best) {
            best = d;
            active = i;
          }
        });
        dots.forEach((dot, i) => dot.classList.toggle('active', i === active));
      },
      { passive: true }
    );
  }

  // Launch-Formular
  const form = document.querySelector<HTMLFormElement>('[data-launch-form]');
  if (form) {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const msg = form.querySelector<HTMLElement>('.form-msg')!;
    const success = form.parentElement!.querySelector<HTMLElement>('.launch-success')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');

    const showSuccess = () => {
      form.hidden = true;
      success.hidden = false;
    };

    input.addEventListener('input', () => {
      input.removeAttribute('aria-invalid');
      msg.textContent = '';
    });

    form.addEventListener('submit', async (event) => {
      const email = input.value.trim();
      const valid = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
      if (!valid) {
        event.preventDefault();
        input.setAttribute('aria-invalid', 'true');
        msg.textContent = 'Bitte gib eine gültige E-Mail-Adresse ein.';
        input.focus();
        return;
      }
      // Bots füllen das versteckte Feld aus → still ignorieren
      if (honeypot && honeypot.value) {
        event.preventDefault();
        showSuccess();
        return;
      }

      const action = form.getAttribute('action');
      // Klassisches Absenden (z. B. Mailchimp, Shopify): Browser übernimmt
      if (action && form.dataset.mode === 'native') return;

      event.preventDefault();
      // Vorschau-Modus ohne Dienst: nur Danke-Meldung zeigen
      if (!action) {
        showSuccess();
        return;
      }

      button.disabled = true;
      try {
        const data = new FormData(form);
        data.delete('website');
        const res = await fetch(action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        showSuccess();
      } catch {
        msg.textContent = 'Das hat leider nicht geklappt. Bitte versuch es gleich noch einmal.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
