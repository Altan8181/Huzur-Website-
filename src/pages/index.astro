    margin-bottom: 14px;
  }
  .step p { margin: 0; }
  .ritual-tip {
    max-width: 620px;
    margin: 88px auto 0;
    padding: 24px 28px;
    border: 1px solid rgba(227, 167, 92, 0.25);
    border-radius: 4px;
