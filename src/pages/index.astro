  .ritual .wrap { position: relative; }
  .ritual-head { text-align: center; margin-bottom: 72px; }
  .ritual .kicker { color: var(--amber-light); }
  .ritual .section-title { color: var(--cream); font-weight: 400; }
  .ritual .section-title em { color: var(--amber-light); }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 64px;
    counter-reset: step;
  }
  .step {
    text-align: center;
